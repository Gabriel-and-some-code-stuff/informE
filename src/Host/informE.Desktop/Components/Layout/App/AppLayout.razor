@inherits LayoutComponentBase
@using informE.Contracts.Dtos.Api
@inject NavigationManager Navigation
@inject informE.Desktop.Services.InformEApiClient Api
@implements IDisposable

<div class="app-shell @(IsViewer ? "viewer-shell" : "admin-shell")">
    <aside class="sidebar @(menuOpen ? "open" : null) @(sidebarCollapsed ? "collapsed" : null)">
        <div class="sidebar-brand">
            <a class="brand-mark" href="@(IsViewer ? "/dashboard/viewer" : "/dashboard/admin")" aria-label="Página inicial">
                <img class="brand-full" src="images/logo-full.png" alt="informE" />
                <img class="brand-icon" src="images/logo-icon.png" alt="" aria-hidden="true" />
            </a>
            <button class="collapse-button" type="button" @onclick="ToggleSidebar"
                    aria-label="@(sidebarCollapsed ? "Expandir menu" : "Recolher menu")"
                    title="@(sidebarCollapsed ? "Expandir menu" : "Recolher menu")">
                <LucideIcon Name="chevron-left" Size="18" />
            </button>
        </div>

        <!-- Navegação lateral -->
        <nav class="sidebar-nav" aria-label="Navegação principal">
            <a class="nav-link @(IsActive("/dashboard") ? "active" : null)"
               href="@(IsViewer ? "/dashboard/viewer" : "/dashboard/admin")" data-tooltip="Dashboard">
                <LucideIcon Name="layout-dashboard" Size="20" />
                <span>Dashboard</span>
            </a>

            @if (IsViewer)
            {
                <a class="nav-link @(IsActive("/machines") ? "active" : null)" href="/machines" data-tooltip="Máquinas">
                    <LucideIcon Name="monitor" Size="20" />
                    <span>Máquinas</span>
                </a>
            }
            else
            {
                <a class="nav-link @(GroupsActive ? "active" : null)" href="/groups" data-tooltip="Grupos">
                    <LucideIcon Name="flask-conical" Size="20" />
                    <span>Grupos</span>
                </a>
                <a class="nav-link @(EquipmentsActive ? "active" : null)" href="/equipments" data-tooltip="Equipamentos">
                    <LucideIcon Name="monitor" Size="20" />
                    <span>Equipamentos</span>
                </a>
                <a class="nav-link @(IsActive("/executions") || IsActive("/execucoes") ? "active" : null)"
                   href="/executions" data-tooltip="Execuções">
                    <LucideIcon Name="play" Size="20" />
                    <span>Execuções</span>
                </a>
                <a class="nav-link @(IsActive("/inventory") ? "active" : null)" href="/inventory" data-tooltip="Inventário">
                    <LucideIcon Name="package" Size="20" />
                    <span>Inventário</span>
                </a>
                <a class="nav-link @(IsActive("/accounts") ? "active" : null)" href="/accounts" data-tooltip="Administração de Contas">
                    <LucideIcon Name="users" Size="20" />
                    <span>Administração de Contas</span>
                </a>
            }

            <a class="nav-link @(IsActive("/settings") ? "active" : null)" href="/settings" data-tooltip="Configurações">
                <LucideIcon Name="settings" Size="20" />
                <span>Configurações</span>
            </a>
        </nav>

        <!-- Conta -->
        <div class="account-area">
            <div class="account-menu">
                <a href="/profile">Meu Perfil</a>
                <button class="logout-button" type="button" @onclick="Logout">Sair da Conta</button>
            </div>
            <div class="account-card">
                <span class="avatar">@(IsViewer ? "EU" : "AU")</span>
                <span class="account-copy">
                    <strong>@UserName</strong>
                    <small>@UserEmail</small>
                </span>
                <span class="account-chevron">⌃</span>
            </div>
        </div>
    </aside>

    <!-- Barra superior -->
    <div class="main-area">
        <header class="topbar">
            <button class="mobile-menu" type="button" @onclick="ToggleMenu" aria-label="Abrir menu">☰</button>
            <div class="search-box">
                <LucideIcon Name="search" Size="18" />
                <input aria-label="Busca" placeholder="@(IsViewer ? "Buscar máquinas..." : "Buscar dispositivos, grupos, usuários...")" />
            </div>

            <div class="topbar-actions">
                <button class="status-pill sync" type="button" @onclick="Synchronize">
                    <span class="sync-icon">↻</span>
                    <span>Sincronizado</span>
                    <small>@syncText</small>
                </button>

                <div class="notification-area">
                    <button class="notification-button" type="button" aria-label="Notificações" @onclick="ToggleNotifications">
                        <LucideIcon Name="bell" Size="19" />
                        @if (recentAlerts.Count > 0)
                        {
                            <span></span>
                        }
                    </button>
                    @if (notificationsOpen)
                    {
                        <div class="notification-click-outside" @onclick="CloseNotifications"></div>
                        <div class="notification-panel">
                            <div class="notification-head">
                                <strong>Notificações</strong>
                                <small>@recentAlerts.Count recentes</small>
                            </div>
                            @if (alertsLoading)
                            {
                                <p class="notification-empty">Carregando alertas...</p>
                            }
                            else if (recentAlerts.Count == 0)
                            {
                                <p class="notification-empty">Nenhum alerta recente.</p>
                            }
                            else
                            {
                                @foreach (var alert in recentAlerts)
                                {
                                    <button class="notification-item" type="button" @onclick="() => OpenAlert(alert)">
                                        <span class="notification-dot"></span>
                                        <span>
                                            <strong>@alert.DeviceHostname</strong>
                                            <small>@alert.Categoria · @alert.OcorridoEm.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="app-content">@Body</main>
    </div>

    @if (menuOpen)
    {
        <button class="mobile-overlay" type="button" @onclick="ToggleMenu" aria-label="Fechar menu"></button>
    }
</div>

@code {
    // Estado da interface
    private bool menuOpen;
    private bool sidebarCollapsed;
    private bool notificationsOpen;
    private bool alertsLoading;
    private string syncText = "há 2 min";
    private readonly List<AlertListItemDto> recentAlerts = [];

    // Sessão e usuário
    private bool IsViewer => string.Equals(
        informE.Desktop.Components.State.AppSession.Role,
        "Viewer", StringComparison.OrdinalIgnoreCase);

    private string UserEmail => string.IsNullOrWhiteSpace(informE.Desktop.Components.State.AppSession.Email)
        ? "—" : informE.Desktop.Components.State.AppSession.Email;

    private string UserName => string.IsNullOrWhiteSpace(informE.Desktop.Components.State.AppSession.Username)
        ? "Usuário" : informE.Desktop.Components.State.AppSession.Username;

    // A rota de detalhes pode pertencer a Grupos ou Equipamentos conforme sua origem.
    private bool IsEquipmentRoute => IsActive("/equipments") || IsActive("/equipamentos");
    private bool FromGroups => IsEquipmentRoute && QueryValue("from").Equals("groups", StringComparison.OrdinalIgnoreCase);
    private bool GroupsActive => IsActive("/groups") || IsActive("/grupos") || FromGroups;
    private bool EquipmentsActive => IsEquipmentRoute && !FromGroups;

    private bool IsActive(string route)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimStart('/');
        return path.Equals(route, StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string QueryValue(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }
        return string.Empty;
    }

    // A atualização é necessária porque o layout permanece montado ao trocar de página.
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (!IsViewer && informE.Desktop.Components.State.AppSession.IsAuthenticated)
            await LoadAlertsAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // Interações do menu
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;
    private void CloseNotifications() => notificationsOpen = false;

    // Notificações e sincronização
    private void Synchronize()
    {
        syncText = "agora";
        _ = LoadAlertsAsync();
    }

    private async Task ToggleNotifications()
    {
        notificationsOpen = !notificationsOpen;
        if (notificationsOpen && recentAlerts.Count == 0)
            await LoadAlertsAsync();
    }

    private async Task LoadAlertsAsync()
    {
        if (IsViewer) return;
        alertsLoading = true;
        try
        {
            var response = await Api.GetAlertsAsync(dias: 7, recentes: 5);
            recentAlerts.Clear();
            recentAlerts.AddRange(response.Recentes.OrderByDescending(x => x.OcorridoEm).Take(5));
        }
        catch
        {
            recentAlerts.Clear();
        }
        finally
        {
            alertsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAlert(AlertListItemDto alert)
    {
        notificationsOpen = false;
        Navigation.NavigateTo($"/equipments/{alert.DeviceId}");
    }

    // Encerramento da sessão
    private async Task Logout()
    {
        var loginRoute = IsViewer ? "/login/viewer" : "/login/admin";
        try
        {
            await Api.LogoutAsync();
        }
        catch
        {
            // O logout local continua mesmo se o servidor estiver indisponível.
        }

        informE.Desktop.Components.State.AppSession.Clear();
        Navigation.NavigateTo(loginRoute);
    }
}
