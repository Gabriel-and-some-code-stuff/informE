@inherits LayoutComponentBase
@using informE.Contracts.Dtos.Api
@inject NavigationManager Navigation
@inject informE.Desktop.Services.InformEApiClient Api

<div class="app-shell @(IsViewer ? "viewer-shell" : "admin-shell")">
    <aside class="sidebar @(menuOpen ? "open" : null) @(sidebarCollapsed ? "collapsed" : null)">
        <div class="sidebar-brand">
            <a class="brand-mark" href="@(IsViewer ? "/dashboard/viewer" : "/dashboard/admin")" aria-label="Página inicial">
                <img class="brand-full" src="images/logo-full.png" alt="informE" />
                <img class="brand-icon" src="images/logo-icon.png" alt="" aria-hidden="true" />
            </a>
            <button class="collapse-button" type="button" @onclick="ToggleSidebar" aria-label="@(sidebarCollapsed ? "Expandir menu" : "Recolher menu")" title="@(sidebarCollapsed ? "Expandir menu" : "Recolher menu")">
                <LucideIcon Name="chevron-left" Size="18" />
            </button>
        </div>

        <nav class="sidebar-nav" aria-label="Navegação principal">
            <a class="nav-link @(IsActive("/dashboard") ? "active" : null)" href="@(IsViewer ? "/dashboard/viewer" : "/dashboard/admin")" data-tooltip="Dashboard">
                <LucideIcon Name="layout-dashboard" Size="20" />
                <span>Dashboard</span>
            </a>

            @if (IsViewer)
            {
                <a class="nav-link @(IsActive("/machines") ? "active" : null)" href="/machines" data-tooltip="Máquinas">
                    <LucideIcon Name="monitor" Size="20" />
                    <span>Máquinas</span>
                </a>
            }
            else
            {
                <a class="nav-link @(IsActive("/groups") || IsActive("/grupos") ? "active" : null)" href="/groups" data-tooltip="Grupos">
                    <LucideIcon Name="flask-conical" Size="20" />
                    <span>Grupos</span>
                </a>
                <a class="nav-link @(IsActive("/equipments") || IsActive("/equipamentos") ? "active" : null)" href="/equipments" data-tooltip="Equipamentos">
                    <LucideIcon Name="monitor" Size="20" />
                    <span>Equipamentos</span>
                </a>
                <a class="nav-link @(IsActive("/executions") || IsActive("/execucoes") ? "active" : null)" href="/executions" data-tooltip="Execuções">
                    <LucideIcon Name="play" Size="20" />
                    <span>Execuções</span>
                </a>
                <a class="nav-link @(IsActive("/inventory") ? "active" : null)" href="/inventory" data-tooltip="Inventário">
                    <LucideIcon Name="package" Size="20" />
                    <span>Inventário</span>
                </a>
                <a class="nav-link @(IsActive("/accounts") ? "active" : null)" href="/accounts" data-tooltip="Administração de Contas">
                    <LucideIcon Name="users" Size="20" />
                    <span>Administração de Contas</span>
                </a>
            }

            <a class="nav-link @(IsActive("/settings") ? "active" : null)" href="/settings" data-tooltip="Configurações">
                <LucideIcon Name="settings" Size="20" />
                <span>Configurações</span>
            </a>
        </nav>

        <div class="account-area">
            <div class="account-menu">
                <a href="/profile">Meu Perfil</a>
                <button class="logout-button" type="button" @onclick="Logout">Sair da Conta</button>
            </div>
            <div class="account-card">
                <span class="avatar">@(IsViewer ? "EU" : "AU")</span>
                <span class="account-copy">
                    <strong>@UserName</strong>
                    <small>@UserEmail</small>
                </span>
                <span class="account-chevron">⌃</span>
            </div>
        </div>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <button class="mobile-menu" type="button" @onclick="ToggleMenu" aria-label="Abrir menu">☰</button>

            <div class="search-box">
                <LucideIcon Name="search" Size="18" />
                <input aria-label="Busca" placeholder="@(IsViewer ? "Buscar máquinas..." : "Buscar dispositivos, grupos, usuários...")" />
            </div>

            <div class="topbar-actions">
                <button class="status-pill sync" type="button" @onclick="Synchronize">
                    <span class="sync-icon">↻</span>
                    <span>Sincronizado</span>
                    <small>@syncText</small>
                </button>
                <div class="status-pill online">
                    <span class="online-dot"></span>
                    <span>Servidor Online</span>
                </div>
                <div class="notification-area">
                    <button class="notification-button" type="button" aria-label="Notificações" @onclick="ToggleNotifications">
                        <LucideIcon Name="bell" Size="19" />
                        @if (recentAlerts.Count > 0) { <span></span> }
                    </button>
                    @if (notificationsOpen)
                    {
                        <div class="notification-panel">
                            <div class="notification-head"><strong>Notificações</strong><small>@recentAlerts.Count recentes</small></div>
                            @if (alertsLoading)
                            {
                                <p class="notification-empty">Carregando alertas...</p>
                            }
                            else if (recentAlerts.Count == 0)
                            {
                                <p class="notification-empty">Nenhum alerta recente.</p>
                            }
                            else
                            {
                                @foreach (var alert in recentAlerts)
                                {
                                    <button class="notification-item" type="button" @onclick="() => OpenAlert(alert)">
                                        <span class="notification-dot"></span>
                                        <span><strong>@alert.DeviceHostname</strong><small>@alert.Categoria · @alert.OcorridoEm.ToLocalTime().ToString("dd/MM HH:mm")</small></span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>

    @if (menuOpen)
    {
        <button class="mobile-overlay" type="button" @onclick="ToggleMenu" aria-label="Fechar menu"></button>
    }
</div>

@code {
    private bool menuOpen;
    private bool sidebarCollapsed;
    private bool notificationsOpen;
    private bool alertsLoading;
    private string syncText = "há 2 min";
    private readonly List<AlertListItemDto> recentAlerts = [];

    // O menu decide pelo PAPEL de quem está logado, não pela URL.
    //
    // BUG CORRIGIDO: era `Navigation.Uri.Contains("/viewer")`. Um Usuario Comum
    // que navegasse para /equipamentos deixava de ter "/viewer" no endereço,
    // IsViewer virava false, e o menu de ADMINISTRADOR aparecia inteiro --
    // Grupos, Inventario, Administracao de Contas. O servidor recusa as
    // chamadas, mas oferecer o que vai ser recusado é defeito por si: parece
    // falha de segurança e não há como a pessoa saber que não devia clicar.
    //
    // O papel vem do token, gravado no AppSession no login.
    private static bool IsViewer =>
        string.Equals(
            informE.Desktop.Components.State.AppSession.Role,
            "Viewer",
            StringComparison.OrdinalIgnoreCase);

    private string UserEmail
    {
        get
        {
            var email = informE.Desktop.Components.State.AppSession.Email;
            return string.IsNullOrWhiteSpace(email)
                ? "—"
                : email;
        }
    }

    private string UserName
    {
        get
        {
            var username = informE.Desktop.Components.State.AppSession.Username;
            return string.IsNullOrWhiteSpace(username)
                ? "Usuário"
                : username;
        }
    }

    private bool IsActive(string route)
    {
        var relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        return relative.StartsWith(route, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsViewer && informE.Desktop.Components.State.AppSession.IsAuthenticated)
            await LoadAlertsAsync();
    }

    private void Synchronize()
    {
        syncText = "agora";
        _ = LoadAlertsAsync();
    }

    private async Task ToggleNotifications()
    {
        notificationsOpen = !notificationsOpen;
        if (notificationsOpen && recentAlerts.Count == 0)
            await LoadAlertsAsync();
    }

    private async Task LoadAlertsAsync()
    {
        if (IsViewer) return;
        alertsLoading = true;
        try
        {
            var response = await Api.GetAlertsAsync(dias: 7, recentes: 5);
            recentAlerts.Clear();
            recentAlerts.AddRange(response.Recentes.OrderByDescending(x => x.OcorridoEm).Take(5));
        }
        catch
        {
            recentAlerts.Clear();
        }
        finally
        {
            alertsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAlert(AlertListItemDto alert)
    {
        notificationsOpen = false;
        Navigation.NavigateTo($"/equipments/{alert.DeviceId}");
    }

    private async Task Logout()
    {
        var loginRoute = IsViewer ? "/login/viewer" : "/login/admin";

        try
        {
            await Api.LogoutAsync();
        }
        catch
        {
            // O logout local continua mesmo se o servidor estiver indisponível.
        }

        informE.Desktop.Components.State.AppSession.Clear();
        Navigation.NavigateTo(loginRoute);
    }
}