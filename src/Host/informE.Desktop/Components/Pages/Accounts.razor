@page "/contas"
@page "/administracao-de-contas"
@layout informE.Desktop.Components.Layout.App.AppLayout
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation

<PageTitle>Administração de Contas | informE</PageTitle>

@if (!EhAdministrador)
{
    <div class="accounts-page">
        <div class="empty-state">
            <strong>Esta área é da administração</strong>
            <span>Sua conta não tem permissão para gerenciar usuários.</span>
        </div>
    </div>
}
else
{
<div class="accounts-page">
    <header class="accounts-header">
        <div>
            <h1>Administração de Contas</h1>
            <p>Usuários com acesso ao informE</p>
        </div>

        <button class="new-account-button" type="button" @onclick="AbrirNovo">
            <span class="btn-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span>
            Novo Usuário
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <div class="page-message error" role="alert">
            <span>!</span>
            <div>
                <strong>Não foi possível carregar as contas</strong>
                <small>@pageError</small>
            </div>
            <button type="button" @onclick="CarregarAsync">Tentar novamente</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(aviso))
    {
        <div class="page-message ok" role="status">
            <span>✓</span>
            <div><strong>@aviso</strong></div>
        </div>
    }

    <section class="accounts-filters" aria-label="Filtros">
        <label class="filter-field">
            <span>Papel</span>
            <select value="@filtroPapel" @onchange="OnPapelChanged">
                <option value="">Todos</option>
                <option value="SuperAdmin">Super Admin</option>
                <option value="Admin">Administrador</option>
                <option value="Viewer">Usuário Comum</option>
            </select>
        </label>

        <label class="filter-field">
            <span>Situação</span>
            <select value="@filtroAtivo" @onchange="OnAtivoChanged">
                <option value="">Todas</option>
                <option value="true">Ativas</option>
                <option value="false">Desativadas</option>
            </select>
        </label>

        <label class="filter-field grow">
            <span>Buscar</span>
            <input type="search" placeholder="Nome, e-mail ou código" value="@busca" @oninput="OnBuscaInput" />
        </label>
    </section>

    <section class="accounts-panel" aria-label="Lista de contas">
        @if (loading)
        {
            <div class="loading-state">
                <span class="loader"></span>
                <p>Carregando contas...</p>
            </div>
        }
        else if (usuarios.Count == 0)
        {
            <div class="empty-state">
                <strong>Nenhuma conta encontrada</strong>
                <span>Ajuste os filtros ou crie um usuário novo.</span>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="accounts-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Papel</th>
                            <th>Situação</th>
                            <th>Criada em</th>
                            <th class="acoes-col">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in usuarios)
                        {
                            <tr class="@(u.IsActive ? null : "inativa")">
                                <td class="codigo">@u.Code</td>
                                <td><strong>@u.Username</strong></td>
                                <td>@u.Email</td>
                                <td>
                                    <span class="papel-wrap @u.Role.ToLowerInvariant()">@NomeDoPapel(u.Role)</span>
                                </td>
                                <td>
                                    <span class="situacao-wrap @(u.IsActive ? "ativa" : "desativada")">
                                        @(u.IsActive ? "Ativa" : "Desativada")
                                    </span>
                                </td>
                                <td>@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="acoes-col">
                                    <div class="acoes">
                                        <button type="button" class="acao" @onclick="() => AbrirEdicao(u)">
                                            Editar
                                        </button>

                                        @if (PodeMudarPapel(u))
                                        {
                                            <button type="button" class="acao" @onclick="() => AbrirPapel(u)">
                                                Papel
                                            </button>
                                        }

                                        @if (PodeDesativar(u))
                                        {
                                            <button type="button"
                                                    class="acao @(u.IsActive ? "perigo" : null)"
                                                    disabled="@(salvandoId == u.Id)"
                                                    @onclick="() => AlternarAtivoAsync(u)">
                                                @(u.IsActive ? "Desativar" : "Reativar")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
}

@if (EhAdministrador && modal is not ModalAberto.Nenhum)
{
    <div class="modal-backdrop" @onclick="FecharModal"></div>
    <div class="modal" role="dialog" aria-modal="true">
        <header class="modal-header">
            <h2>@TituloDoModal</h2>
            <button type="button" class="modal-close" @onclick="FecharModal" aria-label="Fechar">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </header>

        <div class="modal-body">
            @if (modal is ModalAberto.Novo)
            {
                <label class="campo">
                    <span>Nome de usuário</span>
                    <input type="text" @bind="form.Username" @bind:event="oninput" maxlength="45" placeholder="ex.: mariana" />
                    @* O Domain aceita SO letras e numeros (User.ValidateUsername).
                       Sem esta dica, "mariana.silva" tomava 400 com a mensagem
                       "contem caracteres invalidos" e a pessoa nao sabia o que
                       corrigir. *@
                    <small class="campo-dica @(NomeInvalido ? "erro" : null)">
                        Apenas letras e números, sem espaço, ponto ou acento.
                    </small>
                </label>

                <label class="campo">
                    <span>E-mail institucional</span>
                    <input type="email" @bind="form.Email" @bind:event="oninput" placeholder="nome@cps.sp.gov.br" />
                </label>

                <label class="campo">
                    <span>Senha inicial</span>
                    <input type="password" @bind="form.Password" @bind:event="oninput" placeholder="mínimo 8 caracteres" />
                </label>

                <label class="campo">
                    <span>Papel</span>
                    <select @bind="form.Role">
                        @foreach (var papel in PapeisQuePodeCriar)
                        {
                            <option value="@papel">@NomeDoPapel(papel)</option>
                        }
                    </select>
                </label>

                <p class="campo-ajuda">
                    @(EhSuperAdmin
                        ? "Como Super Admin, você pode criar qualquer papel."
                        : "Como Administrador, você pode criar apenas Usuário Comum.")
                </p>
            }
            else if (modal is ModalAberto.Editar)
            {
                <label class="campo">
                    <span>Nome de usuário</span>
                    <input type="text" @bind="form.Username" @bind:event="oninput" maxlength="45" />
                    <small class="campo-dica @(NomeInvalido ? "erro" : null)">
                        Apenas letras e números, sem espaço, ponto ou acento.
                    </small>
                </label>

                <label class="campo">
                    <span>E-mail institucional</span>
                    <input type="email" @bind="form.Email" @bind:event="oninput" />
                </label>
            }
            else if (modal is ModalAberto.Papel)
            {
                <p class="campo-ajuda">
                    Alterando o papel de <strong>@selecionado?.Username</strong>.
                </p>

                <label class="campo">
                    <span>Novo papel</span>
                    <select @bind="form.Role">
                        @foreach (var papel in PapeisQuePodeCriar)
                        {
                            <option value="@papel">@NomeDoPapel(papel)</option>
                        }
                    </select>
                </label>
            }

            @if (!string.IsNullOrWhiteSpace(modalError))
            {
                <div class="modal-error" role="alert">@modalError</div>
            }
        </div>

        <footer class="modal-footer">
            <button class="primary-button" type="button" @onclick="SalvarAsync" disabled="@(salvando || !FormValido)">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
            <button class="secondary-button" type="button" @onclick="FecharModal" disabled="@salvando">
                Cancelar
            </button>
        </footer>
    </div>
}

@code {
    private readonly List<UserListItemDto> usuarios = [];

    private bool loading = true;
    private bool salvando;
    private Guid? salvandoId;

    private string? pageError;
    private string? modalError;
    private string? aviso;

    private string filtroPapel = string.Empty;
    private string filtroAtivo = string.Empty;
    private string busca = string.Empty;

    // Mesma razão do filtro de Equipamentos: digitar "mar" dispara 3 chamadas e
    // a resposta da 1ª pode chegar depois da 3ª, pintando o resultado errado.
    private CancellationTokenSource? buscaCts;

    private enum ModalAberto { Nenhum, Novo, Editar, Papel }
    private ModalAberto modal = ModalAberto.Nenhum;

    private UserListItemDto? selecionado;
    private Formulario form = new();

    private sealed class Formulario
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "Viewer";
    }

    // ── Permissões ────────────────────────────────────────────────────────────
    // A tela NÃO decide autorização — o servidor decide, e recusa com 403. Aqui
    // as regras só evitam oferecer o que vai ser recusado: botão que sempre
    // falha é pior que botão ausente.
    //
    // A matriz é a de docs/politica-login-sessao.md §1:
    //   SuperAdmin → SuperAdmin, Admin, Viewer
    //   Admin      → somente Viewer

    private static bool EhSuperAdmin =>
        string.Equals(informE.Desktop.Components.State.AppSession.Role, "SuperAdmin", StringComparison.OrdinalIgnoreCase);

    private static string[] PapeisQuePodeCriar =>
        EhSuperAdmin ? ["Viewer", "Admin", "SuperAdmin"] : ["Viewer"];

    // Trocar papel e SO do SuperAdmin -- e o que PATCH /users/{id}/role exige
    // (RequireRole("SuperAdmin")). Antes a tela oferecia o botao para Admin
    // tambem, e o clique voltava 403: botao que sempre falha e pior que botao
    // ausente.
    private static bool PodeMudarPapel(UserListItemDto u) => EhSuperAdmin;

    // Ninguém desativa a própria conta: quem fizer isso perde o acesso no
    // próximo request e não tem como reverter sozinho.
    private static bool PodeDesativar(UserListItemDto u) =>
        !u.Email.Equals(informE.Desktop.Components.State.AppSession.Email, StringComparison.OrdinalIgnoreCase)
        && (EhSuperAdmin || u.Role.Equals("Viewer", StringComparison.OrdinalIgnoreCase));

    // Espelha User.ValidateUsername: so letras e numeros. A validacao de
    // verdade continua no Domain -- isto so evita a viagem ate o 400.
    private bool NomeInvalido =>
        !string.IsNullOrEmpty(form.Username) && !form.Username.All(char.IsLetterOrDigit);

    private bool FormValido => modal switch
    {
        ModalAberto.Novo =>
            !string.IsNullOrWhiteSpace(form.Username)
            && !NomeInvalido
            && form.Email.Contains('@')
            && form.Password.Length >= 8,

        ModalAberto.Editar =>
            !string.IsNullOrWhiteSpace(form.Username) && !NomeInvalido && form.Email.Contains('@'),

        ModalAberto.Papel => !string.IsNullOrWhiteSpace(form.Role),
        _ => false
    };

    private string TituloDoModal => modal switch
    {
        ModalAberto.Novo => "Novo Usuário",
        ModalAberto.Editar => $"Editar {selecionado?.Username}",
        ModalAberto.Papel => "Alterar Papel",
        _ => string.Empty
    };

    // ── Carga ─────────────────────────────────────────────────────────────────

    protected override Task OnInitializedAsync() =>
        EhAdministrador ? CarregarAsync() : Task.CompletedTask;

    private async Task CarregarAsync()
    {
        loading = true;
        pageError = null;

        try
        {
            await BuscarAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            pageError = TrataOuMensagem(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task BuscarAsync(CancellationToken ct)
    {
        bool? ativo = filtroAtivo switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };

        var lista = await Api.GetUsersAsync(filtroPapel, ativo, busca, ct);

        usuarios.Clear();
        usuarios.AddRange(lista);
    }

    private async Task AplicarFiltrosAsync()
    {
        buscaCts?.Cancel();
        buscaCts?.Dispose();
        buscaCts = new CancellationTokenSource();

        pageError = null;

        try
        {
            await BuscarAsync(buscaCts.Token);
        }
        catch (OperationCanceledException)
        {
            // Filtro trocado no meio — a chamada mais nova assume.
        }
        catch (Exception ex)
        {
            pageError = TrataOuMensagem(ex);
        }
    }

    private Task OnPapelChanged(ChangeEventArgs args)
    {
        filtroPapel = args.Value?.ToString() ?? string.Empty;
        return AplicarFiltrosAsync();
    }

    private Task OnAtivoChanged(ChangeEventArgs args)
    {
        filtroAtivo = args.Value?.ToString() ?? string.Empty;
        return AplicarFiltrosAsync();
    }

    private Task OnBuscaInput(ChangeEventArgs args)
    {
        busca = args.Value?.ToString() ?? string.Empty;
        return AplicarFiltrosAsync();
    }

    // ── Modal ─────────────────────────────────────────────────────────────────

    private void AbrirNovo()
    {
        selecionado = null;
        form = new Formulario { Role = PapeisQuePodeCriar[0] };
        modalError = null;
        aviso = null;
        modal = ModalAberto.Novo;
    }

    private void AbrirEdicao(UserListItemDto u)
    {
        selecionado = u;
        form = new Formulario { Username = u.Username, Email = u.Email, Role = u.Role };
        modalError = null;
        aviso = null;
        modal = ModalAberto.Editar;
    }

    private void AbrirPapel(UserListItemDto u)
    {
        selecionado = u;
        form = new Formulario { Role = u.Role };
        modalError = null;
        aviso = null;
        modal = ModalAberto.Papel;
    }

    private void FecharModal()
    {
        if (salvando)
            return;

        modal = ModalAberto.Nenhum;
        selecionado = null;
        modalError = null;
    }

    private async Task SalvarAsync()
    {
        salvando = true;
        modalError = null;

        try
        {
            switch (modal)
            {
                case ModalAberto.Novo:
                    await Api.CreateUserAsync(new CreateUserRequestDto(
                        form.Username.Trim(), form.Email.Trim(), form.Password, form.Role));
                    aviso = $"Conta de {form.Username.Trim()} criada.";
                    break;

                case ModalAberto.Editar when selecionado is not null:
                    await Api.UpdateUserAsync(selecionado.Id,
                        new UpdateUserRequestDto(form.Username.Trim(), form.Email.Trim()));
                    aviso = "Conta atualizada.";
                    break;

                case ModalAberto.Papel when selecionado is not null:
                    await Api.ChangeUserRoleAsync(selecionado.Id, form.Role);
                    aviso = $"{selecionado.Username} agora é {NomeDoPapel(form.Role)}.";
                    break;
            }

            modal = ModalAberto.Nenhum;
            selecionado = null;

            await BuscarAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            // Erro fica NO MODAL, com o formulário preenchido: fechar e perder o
            // que foi digitado por causa de um e-mail duplicado é hostil.
            modalError = TrataOuMensagem(ex);
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task AlternarAtivoAsync(UserListItemDto u)
    {
        salvandoId = u.Id;
        pageError = null;
        aviso = null;

        try
        {
            await Api.SetUserActiveAsync(u.Id, !u.IsActive);
            aviso = u.IsActive ? $"{u.Username} foi desativado." : $"{u.Username} foi reativado.";

            await BuscarAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            pageError = TrataOuMensagem(ex);
        }
        finally
        {
            salvandoId = null;
        }
    }

    // ── Apresentação ──────────────────────────────────────────────────────────

    private static string NomeDoPapel(string papel) => papel switch
    {
        "SuperAdmin" => "Super Admin",
        "Admin" => "Administrador",
        "Viewer" => "Usuário Comum",
        _ => papel
    };

    private string TrataOuMensagem(Exception ex)
    {
        if (ex is informE.Desktop.Services.InformEApiException api && api.StatusCode == 401)
        {
            Navigation.NavigateTo("/login", replace: true);
            return string.Empty;
        }

        return ex switch
        {
            informE.Desktop.Services.InformEApiException api2 => api2.Message,
            HttpRequestException => "O servidor não respondeu. Verifique se o informE.Server está no ar.",
            _ => "Ocorreu um erro inesperado ao falar com o servidor."
        };
    }

    // Defesa em profundidade: o menu nao oferece esta tela a Usuario Comum, mas
    // o endereco e digitavel. O servidor tambem recusa (RequireRole), entao isto
    // nao e a unica barreira -- e a que evita a tela quebrada, cheia de erro,
    // que seria pior que uma mensagem clara.
    private static bool EhAdministrador =>
        informE.Desktop.Components.State.AppSession.Role is "Admin" or "SuperAdmin";
}
