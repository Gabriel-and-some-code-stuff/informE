@page "/inventory"
@layout informE.Desktop.Components.Layout.App.AppLayout
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation

<PageTitle>Inventário | informE</PageTitle>

<div class="inventory-page">
    <header class="page-header">
        <div>
            <h1>Inventário</h1>
            <p>Composição dos dispositivos monitorados.</p>
        </div>

        <div class="group-filter-wrap">
            <button type="button"
                    class="group-filter-button"
                    aria-haspopup="true"
                    aria-expanded="@groupFilterOpen"
                    @onclick="ToggleGroupFilter">
                <LucideIcon Name="flask-conical" Size="18" />
                <span>@SelectedGroupLabel</span>
                <LucideIcon Name="chevron-down" Size="18" />
            </button>

            @if (groupFilterOpen)
            {
                <div class="filter-overlay" @onclick="CloseGroupFilter"></div>
                <div class="group-filter-menu">
                    <div class="group-filter-title">Filtrar grupos</div>

                    <button type="button"
                            class="group-filter-option @(selectedGroup is null ? "selected" : "")"
                            @onclick="() => SelectGroupAsync(null)">
                        <span class="group-filter-check">
                            @if (selectedGroup is null)
                            {
                                <LucideIcon Name="check" Size="14" />
                            }
                        </span>
                        <span>Todos os Grupos</span>
                    </button>

                    @foreach (var group in groups.OrderBy(x => x.Name))
                    {
                        <button type="button"
                                class="group-filter-option @(selectedGroup == group.Id ? "selected" : "")"
                                @onclick="() => SelectGroupAsync(group.Id)">
                            <span class="group-filter-check">
                                @if (selectedGroup == group.Id)
                                {
                                    <LucideIcon Name="check" Size="14" />
                                }
                            </span>
                            <span>@group.Name</span>
                        </button>
                    }
                </div>
            }
        </div>
    </header>

    @if (loading)
    {
        <div class="state">Carregando inventário...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="state error">@error</div>
    }
    else
    {
        <section class="top-cards" aria-label="Indicadores do inventário">
            <article class="summary-card">
                <div class="summary-heading">
                    <span class="summary-icon cyan"><LucideIcon Name="monitor" Size="20" /></span>
                    <span>Dispositivos</span>
                </div>
                <strong>@GroupDeviceCount</strong>
            </article>
            <article class="summary-card">
                <div class="summary-heading">
                    <span class="summary-icon purple"><LucideIcon Name="boxes" Size="20" /></span>
                    <span>Média de softwares por máquina</span>
                </div>
                <strong>—</strong>
            </article>
        </section>

        <section class="charts-grid" aria-label="Composição do inventário">
            <article class="panel chart-panel">
                <h2>Sistemas Operacionais</h2>
                @if (OsData.Count == 0)
                {
                    <p class="empty">Sem dados disponíveis para este grupo.</p>
                }
                else
                {
                    <ApexChart TItem="ChartPoint" Height="280">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="OsData"
                                         Name="Dispositivos"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(x => x.Label)"
                                         YAggregate="@(x => x.Sum(v => v.Value))" />
                    </ApexChart>
                }
            </article>

            <article class="panel chart-panel">
                <h2>Hardware</h2>
                <ApexChart TItem="ChartPoint" Height="280">
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="HardwareMockData"
                                     Name="Dispositivos"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(x => x.Label)"
                                     YAggregate="@(x => x.Sum(v => v.Value))" />
                </ApexChart>
                <small class="chart-note">Dados demonstrativos: este gráfico não acompanha o filtro de grupos.</small>
            </article>
        </section>

        <section class="table-panel">
            <div class="panel-head">
                <div>
                    <h2>Inventário detalhado por máquina</h2>
                    <small>Dados do cadastro e do inventário disponível.</small>
                </div>
                <span>@filteredDevices.Count registro@(filteredDevices.Count == 1 ? "" : "s")</span>
            </div>

            <div class="table-tools">
                <div class="inventory-search">
                    <LucideIcon Name="search" Size="18" />
                    <input value="@searchText"
                           @oninput="OnSearchAsync"
                           placeholder="Buscar por dispositivo, grupo ou sistema..."
                           aria-label="Buscar no inventário" />
                </div>
            </div>

            @if (filteredDevices.Count == 0)
            {
                <div class="empty-table">Nenhuma máquina encontrada com os filtros atuais.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Dispositivo</th>
                                <th>Grupo</th>
                                <th>Processador</th>
                                <th>RAM</th>
                                <th>Disco</th>
                                <th>BIOS</th>
                                <th>Sistema</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in pagedDevices)
                            {
                                var hardware = hardwareByDevice.GetValueOrDefault(device.Id);
                                <tr>
                                    <td>
                                        <button type="button" class="device-link" @onclick="() => OpenDevice(device.Id)">
                                            @device.Hostname
                                        </button>
                                    </td>
                                    <td>@(device.GroupName ?? "—")</td>
                                    <td>@(hardware?.Cpu ?? "—")</td>
                                    <td>@FormatRam(hardware)</td>
                                    <td>@FormatStorage(hardware)</td>
                                    <td>@(hardware?.Bios ?? "—")</td>
                                    <td>@device.Os</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Paginação do inventário">
                        <button type="button" aria-label="Página anterior"
                                @onclick="PreviousPage" disabled="@(page == 1)">
                            <LucideIcon Name="chevron-left" Size="18" />
                        </button>
                        <span>Página @(page) de @TotalPages</span>
                        <button type="button" aria-label="Próxima página"
                                @onclick="NextPage" disabled="@(page == TotalPages)">
                            <LucideIcon Name="chevron-right" Size="18" />
                        </button>
                    </nav>
                }
            }
        </section>
    }
</div>

@code {
    private readonly List<GroupListItemDto> groups = [];
    private readonly List<DeviceListItemDto> devices = [];
    private readonly List<DeviceListItemDto> filteredDevices = [];
    private readonly List<DeviceListItemDto> pagedDevices = [];
    private readonly Dictionary<Guid, HardwareDto?> hardwareByDevice = [];

    private bool loading = true;
    private bool groupFilterOpen;
    private string? error;
    private string searchText = string.Empty;
    private Guid? selectedGroup;
    private int page = 1;
    private const int PageSize = 10;

    private string SelectedGroupLabel =>
        selectedGroup is null
            ? "Todos os Grupos"
            : groups.FirstOrDefault(x => x.Id == selectedGroup)?.Name ?? "Todos os Grupos";

    private int GroupDeviceCount => devices.Count;

    private List<ChartPoint> OsData => devices
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Os) ? "Não informado" : x.Os)
        .Select(x => new ChartPoint(x.Key, x.Count()))
        .OrderByDescending(x => x.Value)
        .ToList();

    // Mantido do protótipo original; não representa dados coletados pelo agente.
    private static readonly List<ChartPoint> HardwareMockData =
    [
        new("Intel Core i5", 46),
        new("Intel Core i3", 28),
        new("Intel Core i7", 17),
        new("AMD Ryzen", 14)
    ];

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(filteredDevices.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        if (!informE.Desktop.Components.State.AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/login/admin");
            return;
        }

        try
        {
            groups.AddRange(await Api.GetGroupsAsync());
            await LoadDevicesAsync();
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
            loading = false;
        }
    }

    private async Task LoadDevicesAsync()
    {
        loading = true;
        error = null;

        try
        {
            var result = await Api.GetDevicesAsync(selectedGroup);
            devices.Clear();
            devices.AddRange(result.Itens.OrderBy(x => x.Hostname));
            page = 1;
            await ApplyFilterAsync();
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private void ToggleGroupFilter()
    {
        groupFilterOpen = !groupFilterOpen;
    }

    private void CloseGroupFilter()
    {
        groupFilterOpen = false;
    }

    private async Task SelectGroupAsync(Guid? groupId)
    {
        groupFilterOpen = false;
        if (selectedGroup == groupId)
        {
            return;
        }

        selectedGroup = groupId;
        await LoadDevicesAsync();
    }

    private async Task OnSearchAsync(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        page = 1;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        filteredDevices.Clear();

        var query = devices.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            query = query.Where(x =>
                x.Hostname.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.GroupName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Os?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        filteredDevices.AddRange(query.OrderBy(x => x.Hostname));
        if (page > TotalPages)
        {
            page = TotalPages;
        }

        await RefreshPageAsync();
    }

    private async Task RefreshPageAsync()
    {
        pagedDevices.Clear();
        pagedDevices.AddRange(filteredDevices.Skip((page - 1) * PageSize).Take(PageSize));

        foreach (var device in pagedDevices)
        {
            if (hardwareByDevice.ContainsKey(device.Id))
            {
                continue;
            }

            try
            {
                var detail = await Api.GetDeviceAsync(device.Id);
                hardwareByDevice[device.Id] = detail.Hardware;
            }
            catch
            {
                hardwareByDevice[device.Id] = null;
            }
        }
    }

    private async Task PreviousPage()
    {
        if (page <= 1)
        {
            return;
        }

        page--;
        await RefreshPageAsync();
    }

    private async Task NextPage()
    {
        if (page >= TotalPages)
        {
            return;
        }

        page++;
        await RefreshPageAsync();
    }

    private void OpenDevice(Guid id)
    {
        Navigation.NavigateTo($"/equipments/{id}");
    }

    private static string FormatRam(HardwareDto? hardware)
    {
        if (hardware?.RamGb is null)
        {
            return "—";
        }

        return string.IsNullOrWhiteSpace(hardware.RamType)
            ? $"{hardware.RamGb} GB"
            : $"{hardware.RamGb} GB {hardware.RamType}";
    }

    private static string FormatStorage(HardwareDto? hardware)
    {
        if (hardware?.StorageGb is null)
        {
            return "—";
        }

        return string.IsNullOrWhiteSpace(hardware.StorageType)
            ? $"{hardware.StorageGb} GB"
            : $"{hardware.StorageGb} GB {hardware.StorageType}";
    }

    private static string Friendly(Exception ex)
    {
        return ex is HttpRequestException
            ? "Não foi possível conectar ao servidor."
            : ex.Message;
    }

    private sealed record ChartPoint(string Label, int Value);
}
