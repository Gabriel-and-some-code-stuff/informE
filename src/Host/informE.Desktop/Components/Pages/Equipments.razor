
@page "/equipments"
@page "/equipamentos"
@layout informE.Desktop.Components.Layout.App.AppLayout
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Equipamentos | informE</PageTitle>

<div class="equipment-page">
    <header class="page-heading">
        <div>
            <h1>Equipamentos</h1>
            <p>Gerenciamento de dispositivos monitorados</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="equipment-message error" role="alert">
            <span>!</span>
            <div>
                <strong>Não foi possível carregar os equipamentos</strong>
                <small>@errorMessage</small>
            </div>
            <button type="button" @onclick="LoadAsync">Tentar novamente</button>
        </div>
    }

    <section class="summary-grid" aria-label="Resumo dos equipamentos">
        <article class="summary-card">
            <span class="summary-label">
                <span class="metric-icon cyan">
                    <LucideIcon Name="monitor" Size="20" />
                </span>
                Dispositivos
            </span>
            <strong>@summary.Total</strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                <span class="metric-icon green">
                    <LucideIcon Name="circle-check" Size="20" />
                </span>
                Online
            </span>
            <strong>@summary.Online</strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                <span class="metric-icon gray">
                    <LucideIcon Name="circle-x" Size="20" />
                </span>
                Offline
            </span>
            <strong>@summary.Offline</strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                <span class="metric-icon warning">
                    <LucideIcon Name="triangle-alert" Size="20" />
                </span>
                Com problema
            </span>
            <strong>@summary.ComProblema</strong>
        </article>
    </section>

   
    <section class="filter-panel">
        <label class="device-search">
            <LucideIcon Name="search" Size="17" />
            <input value="@searchText"
                   @oninput="OnSearchInput"
                   placeholder="Buscar por nome, IP ou sistema operacional..." />
        </label>

        <div class="equipment-filter-wrap">
            <button class="equipment-filter-button"
                    type="button"
                    @onclick="ToggleGroupFilter">
                <LucideIcon Name="flask-conical" Size="18" />
                <span>@GroupFilterLabel</span>
                <LucideIcon Name="chevron-down" Size="18" />
            </button>

            @if (groupFilterOpen)
            {
                <div class="equipment-filter-overlay"
                     @onclick="CloseFilters"></div>

                <div class="equipment-filter-menu">
                    <div class="equipment-filter-title">
                        Filtrar grupos
                    </div>

                    @foreach (var group in groups.OrderBy(x => x.Name))
                    {
                        <button type="button"
                                class="equipment-filter-option @(selectedGroupIds.Contains(group.Id) ? "selected" : "")"
                                @onclick="() => ToggleGroupAsync(group.Id)">
                            <span class="equipment-filter-check">
                                @if (selectedGroupIds.Contains(group.Id))
                                {
                                    <LucideIcon Name="check" Size="14" />
                                }
                            </span>
                            <span>@group.Name</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="equipment-filter-wrap">
            <button class="equipment-filter-button"
                    type="button"
                    @onclick="ToggleConnectionFilter">
                <LucideIcon Name="wifi" Size="18" />
                <span>@ConnectionFilterLabel</span>
                <LucideIcon Name="chevron-down" Size="18" />
            </button>

            @if (connectionFilterOpen)
            {
                <div class="equipment-filter-overlay"
                     @onclick="CloseFilters"></div>

                <div class="equipment-filter-menu">
                    <div class="equipment-filter-title">
                        Filtrar conexões
                    </div>

                    @foreach (var status in ConnectionOptions)
                    {
                        <button type="button"
                                class="equipment-filter-option @(selectedConnections.Contains(status) ? "selected" : "")"
                                @onclick="() => ToggleConnectionAsync(status)">
                            <span class="equipment-filter-check">
                                @if (selectedConnections.Contains(status))
                                {
                                    <LucideIcon Name="check" Size="14" />
                                }
                            </span>
                            <span>@status</span>
                        </button>
                    }
                </div>
            }
        </div>
    </section>


    @if (loading)
    {
        <div class="loading-state">
            <span class="loader"></span>
            <p>Carregando equipamentos...</p>
        </div>
    }
    else
    {
        @if (ProfessorDevices.Count > 0)
        {
            <section class="professors-section">
                <div class="section-heading">
                    <h2>Computadores dos Professores</h2>
                    <span>@ProfessorDevices.Count equipamentos</span>
                </div>

                @foreach (var device in ProfessorDevices)
                {
                    <button class="professor-card"
                            type="button"
                            @onclick="() => OpenDetails(device.Id)">

                        <div class="professor-icon">
                            <LucideIcon Name="monitor-cog" Size="23" />
                        </div>

                        <div class="professor-main">
                            <span>Computador do Professor</span>
                            <strong>@device.Hostname</strong>
                            <small>
                                @Fallback(device.Os) · @Fallback(device.LastIp)
                            </small>
                        </div>

                        <div class="professor-metric">
                            <span>CPU</span>
                            <strong>@FormatPercent(device.CpuPercent)</strong>
                        </div>

                        <div class="professor-metric">
                            <span>RAM</span>
                            <strong>@FormatPercent(device.RamPercent)</strong>
                        </div>

                        <div class="professor-metric">
                            <span class="health-pill @HealthClass(device.Health)">
                                @HealthLabel(device.Health)
                            </span>
                        </div>

                        <span class="connection-pill @ConnectionClass(device.Status)">
                            <i></i>
                            @ConnectionLabel(device.Status)
                        </span>

                        <LucideIcon Name="chevron-right" Size="19" />
                    </button>
                }
            </section>
        }

        <section class="machines-panel">
            <div class="panel-head">
                <div>
                    <h2>Máquinas dos Alunos</h2>
                    <span>@StudentDevices.Count equipamentos encontrados</span>
                </div>
            </div>

            @if (StudentDevices.Count == 0)
            {
                <div class="empty-state">
                    <strong>Nenhuma máquina encontrada</strong>
                    <span>Tente alterar a busca ou os filtros.</span>
                </div>
            }
            else
            {
                <div class="machine-list">
                    @foreach (var device in PagedStudents)
                    {
                        <button class="machine-row"
                                type="button"
                                @onclick="() => OpenDetails(device.Id)">

                            <div class="machine-name">
                                <span class="machine-dot @ConnectionClass(device.Status)"></span>
                                <div>
                                    <strong>@device.Hostname</strong>
                                    <small>@Fallback(device.LastIp)</small>
                                </div>
                            </div>

                            <div class="machine-metric">
                                <span>CPU</span>
                                <strong>@FormatPercent(device.CpuPercent)</strong>
                            </div>

                            <div class="machine-metric">
                                <span>RAM</span>
                                <strong>@FormatPercent(device.RamPercent)</strong>
                            </div>

                            <div class="machine-metric">
                                <span>Uptime</span>
                                <strong>@FormatUptime(device.UptimeSeconds)</strong>
                            </div>

                            <span class="health-pill @HealthClass(device.Health)">
                                @HealthLabel(device.Health)
                            </span>

                            <span class="connection-pill @ConnectionClass(device.Status)">
                                <i></i>
                                @ConnectionLabel(device.Status)
                            </span>

                            <span class="details">
                                Detalhes
                                <LucideIcon Name="chevron-right" Size="18" />
                            </span>
                        </button>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <div class="pagination">
                        <button type="button"
                                disabled="@(currentPage <= 1)"
                                @onclick="PreviousPage">
                            Anterior
                        </button>

                        <span>Página @currentPage de @TotalPages</span>

                        <button type="button"
                                disabled="@(currentPage >= TotalPages)"
                                @onclick="NextPage">
                            Próxima
                        </button>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private readonly List<DeviceListItemDto> devices = [];
    private readonly List<GroupListItemDto> groups = [];

    private DeviceSummaryDto summary = new(0, 0, 0, 0);

    private bool loading = true;
    private string? errorMessage;

    private string searchText = string.Empty;

    private readonly HashSet<Guid> selectedGroupIds = [];
    private readonly HashSet<string> selectedConnections =
        new(StringComparer.OrdinalIgnoreCase)
        {
        "Online",
        "Offline"
        };

    private static readonly string[] ConnectionOptions =
    [
        "Online",
    "Offline"
    ];

    private bool groupFilterOpen;
    private bool connectionFilterOpen;

    private string GroupFilterLabel =>
        groups.Count == 0 || selectedGroupIds.Count == groups.Count
            ? "Todos os Grupos"
            : selectedGroupIds.Count == 0
                ? "Nenhum grupo"
                : $"{selectedGroupIds.Count} selecionado(s)";

    private string ConnectionFilterLabel =>
        selectedConnections.Count == ConnectionOptions.Length
            ? "Todas as conexões"
            : selectedConnections.Count == 0
                ? "Nenhuma conexão"
                : string.Join(", ", selectedConnections);

    private void ToggleGroupFilter()
    {
        groupFilterOpen = !groupFilterOpen;
        connectionFilterOpen = false;
    }

    private void ToggleConnectionFilter()
    {
        connectionFilterOpen = !connectionFilterOpen;
        groupFilterOpen = false;
    }

    private void CloseFilters()
    {
        groupFilterOpen = false;
        connectionFilterOpen = false;
    }

    private async Task ToggleGroupAsync(Guid id)
    {
        if (!selectedGroupIds.Add(id))
            selectedGroupIds.Remove(id);

        await LoadAsync();
    }

    private async Task ToggleConnectionAsync(string status)
    {
        if (!selectedConnections.Add(status))
            selectedConnections.Remove(status);

        await LoadAsync();
    }


    private int currentPage = 1;
    private const int PageSize = 10;

    private CancellationTokenSource? searchCts;

    private List<DeviceListItemDto> ProfessorDevices =>
        devices
            .Where(x => string.Equals(
                x.Role,
                "Professor",
                StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Hostname)
            .ToList();

    private List<DeviceListItemDto> StudentDevices =>
        devices
            .Where(x => !string.Equals(
                x.Role,
                "Professor",
                StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Hostname)
            .ToList();

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(
            StudentDevices.Count / (double)PageSize));

    private List<DeviceListItemDto> PagedStudents =>
        StudentDevices
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!informE.Desktop.Components.State.AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/login/admin");
            return;
        }

        try
        {
            groups.AddRange(await Api.GetGroupsAsync());
            foreach (var group in groups)
                selectedGroupIds.Add(group.Id);
        }
        catch
        {
            // A listagem continua disponível sem os grupos.
        }

        await LoadAsync();
    }

    
    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var result = await Api.GetDevicesFiltradosAsync(
                null,
                null,
                string.IsNullOrWhiteSpace(searchText)
                    ? null
                    : searchText.Trim());

            devices.Clear();

            var selectedGroupNames = groups
                .Where(g => selectedGroupIds.Contains(g.Id))
                .Select(g => g.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var filtered = result.Itens
                .Where(device =>
                    device.GroupName is not null &&
                    selectedGroupNames.Contains(device.GroupName))
                .Where(device =>
                    selectedConnections.Contains(device.Status))
                .ToList();

            devices.AddRange(filtered);

            summary = new DeviceSummaryDto(
                filtered.Count,
                filtered.Count(x => x.Status == "Online"),
                filtered.Count(x => x.Status == "Offline"),
                filtered.Count(x =>
                    x.Health is "Aviso" or "Critico" or "Erro"));

            currentPage = 1;
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"O informE.Server não respondeu em http://localhost:5020. Erro: {ex.Message}";
        }
        catch (informE.Desktop.Services.InformEApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;

        searchCts?.Cancel();
        searchCts?.Dispose();

        var cts = new CancellationTokenSource();
        searchCts = cts;

        try
        {
            await Task.Delay(300, cts.Token);
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
            currentPage++;
    }

    private void OpenDetails(Guid id) =>
        Navigation.NavigateTo($"/equipments/{id}");

    private static string Fallback(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatPercent(float? value) =>
        value is null ? "—" : $"{Math.Round(value.Value)}%";

    private static string FormatUptime(int? seconds)
    {
        if (seconds is null)
            return "—";

        var span = TimeSpan.FromSeconds(seconds.Value);

        return span.Days > 0
            ? $"{span.Days}d {span.Hours}h"
            : $"{span.Hours}h {span.Minutes}m";
    }

    private static string ConnectionLabel(string status) =>
        status switch
        {
            "Online" => "Online",
            "Offline" => "Offline",
            _ => "Desconhecido"
        };

    private static string ConnectionClass(string status) =>
        status.ToLowerInvariant();

    private static string HealthLabel(string health) =>
        health switch
        {
            "Saudavel" => "Saudável",
            "Aviso" => "Aviso",
            "Critico" => "Crítico",
            "Erro" => "Erro",
            _ => "Desconhecido"
        };

    private static string HealthClass(string health) =>
        health switch
        {
            "Saudavel" => "healthy",
            "Aviso" => "warning",
            "Critico" => "critical",
            "Erro" => "error",
            _ => "unknown"
        };

    public void Dispose()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
    }
}
