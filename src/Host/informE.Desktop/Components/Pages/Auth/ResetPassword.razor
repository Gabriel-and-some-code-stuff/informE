@page "/redefinir-senha"
@layout informE.Desktop.Components.Layout.Auth.AuthLayout
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation

<PageTitle>Redefinir senha | informE</PageTitle>

<main class="forgot-page">
    <section class="forgot-card" aria-labelledby="reset-title">
        <header class="brand-area">
            <div class="brand-logo-frame">
                <img class="brand-logo" src="images/logo-full.png" alt="informE" />
            </div>
            <div class="brand-divider"></div>
        </header>

        <div class="form-area">
            <div class="forgot-form">
                <div class="heading">
                    <h1 id="reset-title">Escolha uma senha nova</h1>
                    <p>O link vale por 1 hora e só pode ser usado uma vez.</p>
                </div>

                @if (concluido)
                {
                    <div class="success" role="status">
                        <span class="ok-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                        <div>
                            <strong>Senha redefinida</strong>
                            <small>Todas as sessões anteriores foram encerradas. Entre com a senha nova.</small>
                        </div>
                    </div>

                    <a class="submit-button link-button" href="/login">Ir para o login</a>
                }
                else if (string.IsNullOrWhiteSpace(token))
                {
                    <div class="form-error" role="alert">
                        Link inválido — não há token no endereço. Peça um novo em
                        &ldquo;Esqueci a senha&rdquo;.
                    </div>

                    <a class="back-link" href="/esqueci-a-senha">← Pedir um link novo</a>
                }
                else
                {
                    <div class="field">
                        <label for="nova-senha">Senha nova</label>
                        <input id="nova-senha" type="password" autocomplete="new-password"
                               placeholder="mínimo 8 caracteres"
                               @bind="novaSenha" @bind:event="oninput" />
                    </div>

                    <div class="field">
                        <label for="confirma-senha">Repita a senha</label>
                        <input id="confirma-senha" type="password" autocomplete="new-password"
                               @bind="confirmacao" @bind:event="oninput" />
                    </div>

                    @* A conferência acontece ANTES de enviar: o servidor não
                       recebe a confirmação, então errar a digitação sem este
                       aviso trocaria a senha para algo que a pessoa não sabe
                       qual é — e o link é de uso único, não dá para repetir. *@
                    @if (!string.IsNullOrEmpty(confirmacao) && novaSenha != confirmacao)
                    {
                        <div class="form-error" role="alert">As duas senhas não são iguais.</div>
                    }
                    else if (!string.IsNullOrEmpty(novaSenha) && novaSenha.Length < SenhaMinima)
                    {
                        <div class="form-error" role="alert">A senha precisa ter ao menos @SenhaMinima caracteres.</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(erro))
                    {
                        <div class="form-error" role="alert">@erro</div>
                    }

                    <button class="submit-button" type="button" @onclick="RedefinirAsync" disabled="@(!Valido || salvando)">
                        @(salvando ? "Salvando..." : "Redefinir senha")
                    </button>

                    <a class="back-link" href="/login">← Voltar para o login</a>
                }
            </div>
        </div>

        <footer class="card-footer">informE Platform <span>•</span> <strong>Online</strong></footer>
    </section>
</main>

@code {
    private const int SenhaMinima = 8;

    private string? token;
    private string novaSenha = string.Empty;
    private string confirmacao = string.Empty;

    private bool salvando;
    private bool concluido;
    private string? erro;

    private bool Valido =>
        novaSenha.Length >= SenhaMinima && novaSenha == confirmacao;

    protected override void OnInitialized()
    {
        // O token vem na query do link, no formato "{sessionId}.{segredo}".
        // Uri.UnescapeDataString porque o Base64Url pode trazer '-' e '_', e o
        // link inteiro passou por escape ao ser montado.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        token = query["token"];
    }

    private async Task RedefinirAsync()
    {
        salvando = true;
        erro = null;

        try
        {
            await Api.ResetPasswordAsync(token!, novaSenha);
            concluido = true;
        }
        catch (informE.Desktop.Services.InformEApiException ex)
        {
            erro = ex.Message;
        }
        catch (HttpRequestException)
        {
            erro = "O servidor não respondeu. Verifique se o informE.Server está no ar.";
        }
        finally
        {
            salvando = false;
        }
    }
}
