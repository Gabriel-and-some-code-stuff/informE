@page "/esqueci-a-senha"
@layout informE.Desktop.Components.Layout.Auth.AuthLayout
@using System.ComponentModel.DataAnnotations
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation

<PageTitle>Esqueci a senha | informE</PageTitle>

<main class="forgot-page">
    <section class="forgot-card" aria-labelledby="forgot-title">
        <header class="brand-area">
            <div class="brand-logo-frame">
                <img class="brand-logo" src="images/logo-full.png" alt="informE" />
            </div>
            <div class="brand-divider"></div>
        </header>

        <div class="form-area">
            <EditForm Model="model" OnValidSubmit="HandleRequest" class="forgot-form">
                <DataAnnotationsValidator />

                <div class="heading">
                    <h1 id="forgot-title">Esqueceu a senha?</h1>
                    <p>Informe o e-mail da sua conta. Enviaremos um link para você escolher uma senha nova.</p>
                </div>

                <div class="field">
                    <label for="recovery-email">Email</label>
                    <InputText id="recovery-email" type="email" autocomplete="email" placeholder="seu@email.com" @bind-Value="model.Email" />
                    <ValidationMessage For="() => model.Email" />
                </div>

                @if (enviado)
                {
                    <div class="success" role="status">
                        <span class="ok-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                        <div>
                            <strong>Solicitação registrada</strong>
                            <small>Se este e-mail tiver conta ativa, o link chegou na caixa de entrada. O link vale 1 hora e só serve uma vez.</small>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(linkDeDesenvolvimento))
                {
                    @* Atalho de DESENVOLVIMENTO.
                       O servidor só devolve este link quando roda em Development
                       E não há SMTP configurado — em produção o campo vem null e
                       o link viaja apenas por e-mail. Sem isto o fluxo era
                       indemonstravel: o token nascia e ninguém o recebia. *@
                    <div class="dev-hint" role="note">
                        <strong>Sem servidor de e-mail nesta máquina</strong>
                        <small>Em produção o link vai para a caixa de entrada. Aqui ele aparece para você continuar:</small>
                        <button type="button" class="dev-link" @onclick="IrParaRedefinicao">
                            Redefinir senha agora →
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <div class="form-error" role="alert">@erro</div>
                }

                <button class="submit-button" type="submit" disabled="@enviando">
                    @(enviando ? "Enviando..." : "Enviar instruções")
                </button>
                <a class="back-link" href="/login">← Voltar para o login</a>
            </EditForm>
        </div>

        <footer class="card-footer">informE Platform <span>•</span> <strong>Online</strong></footer>
    </section>
</main>

@code {
    private readonly RecoveryModel model = new();

    private bool enviando;
    private bool enviado;
    private string? erro;
    private string? linkDeDesenvolvimento;

    private async Task HandleRequest()
    {
        enviando = true;
        erro = null;
        linkDeDesenvolvimento = null;

        try
        {
            var resposta = await Api.ForgotPasswordAsync(model.Email.Trim());

            // Sempre "registrada", exista a conta ou nao: a tela nao pode
            // revelar quais e-mails tem conta -- e o mesmo raciocinio do 401
            // unico no login.
            enviado = true;
            linkDeDesenvolvimento = resposta.LinkDeDesenvolvimento;
        }
        catch (informE.Desktop.Services.InformEApiException ex)
        {
            erro = ex.Message;
        }
        catch (HttpRequestException)
        {
            erro = "O servidor não respondeu. Verifique se o informE.Server está no ar.";
        }
        finally
        {
            enviando = false;
        }
    }

    // O link vem absoluto (https://localhost:5021/redefinir-senha?token=...).
    // A tela precisa apenas do caminho relativo, senao o Blazor tentaria abrir
    // o endereco do SERVIDOR no navegador em vez de navegar dentro do app.
    private void IrParaRedefinicao()
    {
        if (string.IsNullOrWhiteSpace(linkDeDesenvolvimento))
            return;

        var interrogacao = linkDeDesenvolvimento.IndexOf('?');
        var query = interrogacao >= 0 ? linkDeDesenvolvimento[interrogacao..] : string.Empty;

        Navigation.NavigateTo($"/redefinir-senha{query}");
    }

    private sealed class RecoveryModel
    {
        [Required(ErrorMessage = "Informe o email.")]
        [EmailAddress(ErrorMessage = "Informe um email válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
