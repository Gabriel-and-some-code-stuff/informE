@page "/executions"
@page "/execucoes"
@layout informE.Desktop.Components.Layout.App.AppLayout
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api
@inject NavigationManager Navigation

<PageTitle>Execuções | informE</PageTitle>

<div class="executions-page">
    <header class="executions-header">
        <div>
            <h1>Execuções</h1>
            <p>Acompanhe, localize e gerencie as operações remotas.</p>
        </div>
        <button class="primary-action" type="button" @onclick="OpenNewExecution">
            <LucideIcon Name="plus" Size="18" /> Nova execução
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(pageError))
    {
        <div class="page-message error" role="alert">
            <LucideIcon Name="triangle-alert" Size="18" />
            <span>@pageError</span>
            <button type="button" @onclick="LoadPageAsync">Tentar novamente</button>
        </div>
    }

    <section class="execution-tools" aria-label="Filtros de execuções">
        <label class="search-field">
            <LucideIcon Name="search" Size="18" />
            <input aria-label="Pesquisar execuções" placeholder="Pesquisar ID, dispositivo, ação ou responsável..."
                   value="@searchText" @oninput="OnSearchChanged" />
        </label>
        <div class="filter-wrap">
            <button type="button" class="filter-button" @onclick="ToggleGroupFilter" aria-expanded="@groupFilterOpen">
                <LucideIcon Name="flask-conical" Size="17" />
                <span>@GroupFilterLabel</span>
                <LucideIcon Name="chevron-down" Size="16" />
            </button>
            @if (groupFilterOpen)
            {
                <div class="filter-overlay" @onclick="CloseFilters"></div>
                <div class="filter-menu">
                    <div class="filter-title">Filtrar laboratórios</div>
                    <button type="button" class="filter-option @(selectedGroupFilter == "all" ? "selected" : "")" @onclick="SelectAllGroupFilter">
                        <span class="filter-check">@if (selectedGroupFilter == "all") {
                            <LucideIcon Name="check" Size="14" />
                        }
                    </span>
                    <span>Todos os laboratórios</span>
                </button>
                @foreach (var g in groups.OrderBy(x => x.Name))
                {
                    var value = g.Id.ToString();
                    <button type="button" class="filter-option @(selectedGroupFilter == value ? "selected" : "")" @onclick="() => SelectGroupFilter(value)">
                        <span class="filter-check">@if (selectedGroupFilter == value) {
                            <LucideIcon Name="check" Size="14" />
                        }
                    </span>
                    <span>@g.Name</span>
                </button>
            }
        </div>
    }
</div>
<div class="filter-wrap">
    <button type="button" class="filter-button" @onclick="ToggleStatusFilter" aria-expanded="@statusFilterOpen">
        <LucideIcon Name="list-filter" Size="17" />
        <span>@StatusFilterLabel</span>
        <LucideIcon Name="chevron-down" Size="16" />
    </button>
    @if (statusFilterOpen)
    {
        <div class="filter-overlay" @onclick="CloseFilters"></div>
        <div class="filter-menu">
            <div class="filter-title">Filtrar status</div>
            @foreach (var option in StatusOptions)
            {
                <button type="button" class="filter-option @(selectedStatusFilter == option.Value ? "selected" : "")" @onclick="() => SelectStatusFilter(option.Value)">
                    <span class="filter-check">@if (selectedStatusFilter == option.Value) {
                        <LucideIcon Name="check" Size="14" />
                    }
                </span>
                <span>@option.Label</span>
            </button>
        }
    </div>
}
</div>
</section>

<section class="executions-panel" aria-label="Histórico de execuções">
    <div class="panel-heading">
        <div>
            <h2>Histórico de execuções</h2>
            <p>@FilteredExecutions.Count resultado(s) nos registros carregados</p>
        </div>
    </div>
    @if (loading)
    {
        <div class="loading-state"><span class="loader"></span> Carregando execuções...</div>
    }
    else if (FilteredExecutions.Count == 0)
    {
        <div class="empty-state">
            <LucideIcon Name="inbox" Size="27" />
            <strong>Nenhuma execução encontrada</strong>
            <span>Experimente mudar os filtros ou criar uma execução.</span>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="executions-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Dispositivo</th>
                        <th>Ação executada</th>
                        <th>Status</th>
                        <th>Horário</th>
                        <th>Duração</th>
                        <th>Responsável</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PagedExecutions)
                    {
                        <tr>
                            <td><strong class="execution-code">@item.Code</strong></td>
                            <td><strong class="device-name">@item.DeviceHostname</strong></td>
                            <td><span class="action-name"><LucideIcon Name="terminal" Size="15" /> @item.ActionName</span></td>
                            <td><span class="status-pill @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                            <td>@FormatTime(item.ExecutedAt)</td>
                            <td>@FormatDuration(item.DurationMs)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CriadoPor) ? "—" : item.CriadoPor)</td>
                            <td class="row-actions">
                                @if (!string.IsNullOrWhiteSpace(item.Output))
                                {
                                    <button type="button" class="text-action" @onclick="() => OpenLog(item)" title="Ver log">Ver log</button>
                                }
                                @if (CanCancel(item.Status))
                                {
                                    <button type="button" class="cancel-action" @onclick="() => CancelAsync(item)" disabled="@(cancelingTaskId == item.TaskId)" title="Cancelar execução" aria-label="Cancelar execução">
                                        <LucideIcon Name="x" Size="17" />
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <nav class="pagination" aria-label="Paginação das execuções">
                <button type="button" disabled="@(currentPage == 1)" @onclick="() => SetPage(currentPage - 1)" aria-label="Página anterior"><LucideIcon Name="chevron-left" Size="18" /></button>
                <span>Página @(currentPage) de @TotalPages</span>
                <button type="button" disabled="@(currentPage == TotalPages)" @onclick="() => SetPage(currentPage + 1)" aria-label="Próxima página"><LucideIcon Name="chevron-right" Size="18" /></button>
            </nav>
        }
    }
</section>
</div>


<NewExecutionModal @ref="executionModal" OnCompleted="LoadPageAsync" />

@if (selectedLog is not null)
{
    <div class="modal-backdrop" @onclick="CloseLog">
        <section class="log-modal" role="dialog" aria-modal="true" aria-labelledby="log-title" @onclick:stopPropagation="true">
            <header class="modal-header"><div><h2 id="log-title">Log @selectedLog.Code</h2><p>@selectedLog.DeviceHostname · @selectedLog.ActionName</p></div><button class="icon-button" type="button" @onclick="CloseLog" aria-label="Fechar"><LucideIcon Name="x" Size="20" /></button></header>
            <pre>@selectedLog.Output</pre>
        </section>
    </div>
}

@code {
    private readonly List<GroupListItemDto> groups = [];
    private readonly List<ExecutionListItemDto> executions = [];
    private readonly Dictionary<string, string> deviceGroups = new(StringComparer.OrdinalIgnoreCase);
    private NewExecutionModal? executionModal;

    private static readonly (string Value, string Label)[] StatusOptions =
    [
        ("all", "Todos os status"),
        ("Pending", "Em fila"),
        ("Running", "Executando"),
        ("Succeeded", "Concluído"),
        ("Failed", "Falhou"),
        ("Canceled", "Cancelado")
    ];

    private bool loading = true;
    private bool groupFilterOpen;
    private bool statusFilterOpen;
    private string? pageError;
    private string searchText = "";
    private string selectedGroupFilter = "all";
    private string selectedStatusFilter = "all";
    private Guid? cancelingTaskId;
    private ExecutionListItemDto? selectedLog;
    private int currentPage = 1;
    private const int PageSize = 10;

    private string GroupFilterLabel => selectedGroupFilter == "all"
        ? "Todos os laboratórios"
        : groups.FirstOrDefault(x => x.Id.ToString() == selectedGroupFilter)?.Name ?? "Laboratório";

    private string StatusFilterLabel =>
        StatusOptions.FirstOrDefault(x => x.Value == selectedStatusFilter).Label ?? "Todos os status";

    private List<ExecutionListItemDto> FilteredExecutions => executions.Where(item =>
        (string.IsNullOrWhiteSpace(searchText) ||
         (item.Code?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (item.DeviceHostname?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (item.ActionName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (item.CriadoPor?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (selectedStatusFilter == "all" ||
         (selectedStatusFilter == "Pending"
            ? item.Status is "Pending" or "Queued"
            : item.Status == selectedStatusFilter)) &&
        (selectedGroupFilter == "all" ||
         (deviceGroups.TryGetValue(item.DeviceHostname ?? "", out var groupId) &&
          groupId == selectedGroupFilter)))
        .OrderByDescending(x => x.ExecutedAt)
        .ToList();

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(FilteredExecutions.Count / (double)PageSize));

    private List<ExecutionListItemDto> PagedExecutions =>
        FilteredExecutions.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!informE.Desktop.Components.State.AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/login/admin");
            return;
        }

        await LoadPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !informE.Desktop.Components.State.AppSession.IsAuthenticated)
        {
            return;
        }

        var query = ParseQuery();
        if (query.TryGetValue("new", out var open) && open == "1")
        {
            query.TryGetValue("deviceId", out var deviceId);
            query.TryGetValue("groupId", out var groupId);
            query.TryGetValue("group", out var groupName);
            await executionModal!.OpenAsync(
                Guid.TryParse(deviceId, out var id) ? id : null,
                Guid.TryParse(groupId, out var group) ? group : null,
                groupName);
        }
    }

    private async Task LoadPageAsync()
    {
        loading = true;
        pageError = null;
        try
        {
            var result = await Api.GetExecutionsAsync();
            executions.Clear();
            executions.AddRange(result.OrderByDescending(x => x.ExecutedAt));

            try
            {
                if (groups.Count == 0)
                {
                    groups.AddRange(await Api.GetGroupsAsync());
                }
                deviceGroups.Clear();
                var inventory = await Api.GetDevicesAsync();
                foreach (var device in inventory.Itens)
                {
                    var group = groups.FirstOrDefault(x =>
                        string.Equals(x.Name, device.GroupName, StringComparison.OrdinalIgnoreCase));
                    if (group is not null)
                    {
                        deviceGroups[device.Hostname] = group.Id.ToString();
                    }
                }
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or informE.Desktop.Services.InformEApiException)
            {
                // Histórico permanece acessível mesmo se o filtro auxiliar falhar.
            }
            currentPage = 1;
        }
        catch (HttpRequestException ex)
        {
            pageError = $"O servidor não respondeu: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            pageError = "A consulta demorou mais que o esperado.";
        }
        catch (informE.Desktop.Services.InformEApiException ex)
        {
            pageError = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private Task OpenNewExecution() => executionModal!.OpenAsync();

    private void ToggleGroupFilter()
    {
        groupFilterOpen = !groupFilterOpen;
        statusFilterOpen = false;
    }

    private void ToggleStatusFilter()
    {
        statusFilterOpen = !statusFilterOpen;
        groupFilterOpen = false;
    }

    private void SelectAllGroupFilter() => SelectGroupFilter("all");

    private void CloseFilters()
    {
        groupFilterOpen = false;
        statusFilterOpen = false;
    }

    private void SelectGroupFilter(string value)
    {
        selectedGroupFilter = value;
        currentPage = 1;
        CloseFilters();
    }

    private void SelectStatusFilter(string value)
    {
        selectedStatusFilter = value;
        currentPage = 1;
        CloseFilters();
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? "";
        currentPage = 1;
    }

    private void SetPage(int value) => currentPage = Math.Clamp(value, 1, TotalPages);

    private async Task CancelAsync(ExecutionListItemDto item)
    {
        cancelingTaskId = item.TaskId;
        pageError = null;
        try
        {
            await Api.CancelTaskAsync(item.TaskId);
            await LoadPageAsync();
        }
        catch (HttpRequestException)
        {
            pageError = "O servidor não respondeu ao cancelamento.";
        }
        catch (informE.Desktop.Services.InformEApiException ex)
        {
            pageError = ex.Message;
        }
        finally
        {
            cancelingTaskId = null;
        }
    }

    private void OpenLog(ExecutionListItemDto item) => selectedLog = item;
    private void CloseLog() => selectedLog = null;
    private static bool CanCancel(string status) => status is "Pending" or "Queued" or "Running";

    private static string StatusLabel(string status) => status switch
    {
        "Pending" or "Queued" => "Em fila",
        "Running" => "Executando",
        "Succeeded" => "Concluído",
        "Failed" => "Falhou",
        "Canceled" => "Cancelado",
        _ => status
    };

    private static string StatusClass(string status) => status.ToLowerInvariant();
    private static string FormatTime(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM HH:mm");

    private static string FormatDuration(int? durationMs)
    {
        if (durationMs is null)
        {
            return "—";
        }
        var duration = TimeSpan.FromMilliseconds(durationMs.Value);
        return duration.TotalMinutes >= 1
            ? $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s"
            : $"{duration.Seconds}s";
    }

    private Dictionary<string, string> ParseQuery()
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split('=', 2);
            result[Uri.UnescapeDataString(pieces[0])] = pieces.Length > 1
                ? Uri.UnescapeDataString(pieces[1].Replace('+', ' '))
                : "";
        }
        return result;
    }
}
