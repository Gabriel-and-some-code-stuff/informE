@page "/accounts"
@layout informE.Desktop.Components.Layout.App.AppLayout
@using informE.Contracts.Dtos.Api
@inject informE.Desktop.Services.InformEApiClient Api

<PageTitle>Administração de Contas | informE</PageTitle>

<div class="accounts-page">
    <header class="page-header">
        <div>
            <h1>Administração de Contas</h1>
            <p>Gerencie usuários e permissões da plataforma.</p>
        </div>
        <button class="primary-button" type="button" @onclick="OpenCreate"><LucideIcon Name="user-plus" Size="18" /> Novo Usuário</button>
    </header>

    @if (loading)
    {
        <div class="state-card">Carregando usuários...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="state-card error">@error <button type="button" @onclick="LoadAsync">Tentar novamente</button></div>
    }
    else
    {

        <section class="summary-grid" aria-label="Resumo dos usuários">

            <article class="summary-card">
                <span class="summary-icon cyan">
                    <LucideIcon Name="users" Size="20" />
                </span>
                <span>Total de Usuários</span>
                <strong>@users.Count</strong>
            </article>

            <article class="summary-card">
                <span class="summary-icon purple">
                    <LucideIcon Name="shield-check" Size="20" />
                </span>
                <span>Administradores</span>
                <strong>@users.Count(x => x.Role is "Admin" or "SuperAdmin")</strong>
            </article>

            <article class="summary-card">
                <span class="summary-icon green">
                    <LucideIcon Name="user-check" Size="20" />
                </span>
                <span>Usuários Ativos</span>
                <strong>@users.Count(x => x.IsActive)</strong>
            </article>

            <article class="summary-card">
                <span class="summary-icon gray">
                    <LucideIcon Name="monitor" Size="20" />
                </span>
                <span>Sessões Abertas</span>
                <strong>—</strong>
            </article>

        </section>


        <section class="table-panel">
            <div class="table-toolbar">
                <div><strong>Usuários</strong><span>@FilteredUsers.Count</span></div>
                <div class="search"><LucideIcon Name="search" Size="17" /><input value="@search" @oninput="OnSearch" placeholder="Buscar usuário..." /></div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Usuário</th><th>Função</th><th>Status</th><th>Último acesso</th><th>Sessões</th><th>Ações</th></tr></thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td><div class="user-cell"><span class="initials">@Initials(user.Username)</span><div><strong>@user.Username</strong><small>@user.Email</small></div></div></td>
                                <td><span class="role role-@user.Role.ToLowerInvariant()">@RoleLabel(user.Role)</span></td>
                                <td><span class="status @(user.IsActive ? "active" : "inactive")">@(user.IsActive ? "Ativo" : "Inativo")</span></td>
                                <td>—</td><td>—</td>
                                <td class="actions"><div class="action-buttons">
                                    <button type="button" title="Editar" @onclick="() => OpenEdit(user)"><LucideIcon Name="pencil" Size="16" /></button>
                                    <button class="@(user.IsActive ? "danger" : "success")" type="button" title="@(user.IsActive ? "Desativar" : "Ativar")" @onclick="() => AskToggle(user)">
                                        <LucideIcon Name="@(user.IsActive ? "ban" : "lock-open")" Size="16" />
                                    </button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@if (showForm)
{
    <div class="modal-backdrop" @onclick="CloseForm">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-head"><div><LucideIcon Name="@(editing is null ? "user-plus" : "user-cog")" Size="20" /><strong>@(editing is null ? "Criar Novo Usuário" : "Editar Usuário")</strong></div><button @onclick="CloseForm">×</button></div>
            <div class="modal-body">
                <label>Nome completo<input @bind="formName" placeholder="Ex: João Silva" /></label>
                <label>Email<input @bind="formEmail" type="email" placeholder="joao@etec.sp.gov.br" /></label>

                @if (editing is null)
                {
                    <div class="password-field">
                        <label for="temporary-password">Senha temporária</label>

                        <div class="password-input-wrap">
                            <input id="temporary-password"
                                   @bind="formPassword"
                                   type="@(showPassword ? "text" : "password")"
                                   placeholder="••••••••"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    @onclick="() => showPassword = !showPassword"
                                    aria-label="@(showPassword ? "Ocultar senha" : "Mostrar senha")"
                                    aria-pressed="@showPassword">
                                <LucideIcon Name="@(showPassword ? "eye-off" : "eye")"
                                            Size="18" />
                            </button>
                        </div>
                    </div>
                }

                <label>Função
                    <select @bind="formRole">
                        @foreach (var role in AvailableRoles) { <option value="@role">@RoleLabel(role)</option> }
                    </select>
                </label>
                @if (!string.IsNullOrWhiteSpace(formError)) { <div class="form-error">@formError</div> }
            </div>
            <div class="modal-actions"><button class="secondary-button" @onclick="CloseForm">Cancelar</button><button class="primary-button" disabled="@saving" @onclick="SaveAsync">@(saving ? "Salvando..." : editing is null ? "Criar Usuário" : "Salvar Alterações")</button></div>
        </div>
    </div>
}

@if (toggleTarget is not null)
{
    <div class="modal-backdrop" @onclick="CancelToggle">
        <div class="confirm-card" @onclick:stopPropagation="true">
            <LucideIcon Name="@(toggleTarget.IsActive ? "circle-alert" : "circle-check")" Size="28" />
            <h2>@(toggleTarget.IsActive ? "Desativar conta?" : "Ativar conta?")</h2>
            <p>@(toggleTarget.IsActive ? $"{toggleTarget.Username} perderá o acesso e terá as sessões encerradas." : $"{toggleTarget.Username} poderá acessar a plataforma novamente.")</p>
            <div><button class="secondary-button" @onclick="CancelToggle">Cancelar</button><button class="@(toggleTarget.IsActive ? "danger-button" : "primary-button")" @onclick="ToggleActiveAsync">Confirmar</button></div>
        </div>
    </div>
}


@code {
    // Estado da página
    private readonly List<UserListItemDto> users = [];

    private bool loading = true;
    private bool showForm;
    private bool saving;
    private bool showPassword;

    private string? error;
    private string? formError;

    // Campos do formulário
    private string search = "";
    private string formName = "";
    private string formEmail = "";
    private string formPassword = "";
    private string formRole = "Viewer";

    private UserListItemDto? editing;
    private UserListItemDto? toggleTarget;

    // Permissões
    private bool IsSuperAdmin =>
        informE.Desktop.Components.State.AppSession.Role == "SuperAdmin";

    private IEnumerable<string> AvailableRoles =>
        IsSuperAdmin
            ? ["Viewer", "Admin", "SuperAdmin"]
            : ["Viewer"];

    // Pesquisa de usuários
    private List<UserListItemDto> FilteredUsers =>
        users.Where(user =>
            string.IsNullOrWhiteSpace(search) ||
            user.Username.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            user.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            user.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
        ).ToList();

    // Inicialização
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // Carregamento de usuários
    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            users.Clear();

            var result = await Api.GetUsersAsync();
            users.AddRange(result);
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loading = false;
        }
    }

    // Pesquisa
    private void OnSearch(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
    }

    // Criação de usuário
    private void OpenCreate()
    {
        editing = null;

        formName = "";
        formEmail = "";
        formPassword = "";
        formRole = "Viewer";

        formError = null;
        showPassword = false;
        showForm = true;
    }

    // Edição de usuário
    private void OpenEdit(UserListItemDto user)
    {
        editing = user;

        formName = user.Username;
        formEmail = user.Email;
        formPassword = "";
        formRole = user.Role;

        formError = null;
        showPassword = false;
        showForm = true;
    }

    // Fechamento do formulário
    private void CloseForm()
    {
        showForm = false;
        showPassword = false;
        formPassword = "";
        editing = null;
    }

    // Salvamento do usuário
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(formName) ||
            string.IsNullOrWhiteSpace(formEmail) ||
            (editing is null && string.IsNullOrWhiteSpace(formPassword)))
        {
            formError = "Preencha os campos obrigatórios.";
            return;
        }

        saving = true;
        formError = null;

        try
        {
            if (editing is null)
            {
                await Api.CreateUserAsync(
                    new(
                        formName.Trim(),
                        formEmail.Trim(),
                        formPassword,
                        formRole
                    )
                );
            }
            else
            {
                await Api.UpdateUserAsync(
                    editing.Id,
                    new(
                        formName.Trim(),
                        formEmail.Trim()
                    )
                );

                if (IsSuperAdmin && editing.Role != formRole)
                {
                    await Api.ChangeUserRoleAsync(editing.Id, formRole);
                }
            }

            CloseForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            formError = Friendly(ex);
        }
        finally
        {
            saving = false;
        }
    }

    // Ativação e desativação de usuários
    private void AskToggle(UserListItemDto user)
    {
        toggleTarget = user;
    }

    private void CancelToggle()
    {
        toggleTarget = null;
    }

    private async Task ToggleActiveAsync()
    {
        if (toggleTarget is null)
        {
            return;
        }

        try
        {
            await Api.SetUserActiveAsync(
                toggleTarget.Id,
                !toggleTarget.IsActive
            );

            toggleTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
            toggleTarget = null;
        }
    }

    // Formatação de informações
    private static string Initials(string value)
    {
        var parts = value.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries
        );

        if (parts.Length > 1)
        {
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }

        return value[..Math.Min(2, value.Length)].ToUpperInvariant();
    }

    private static string RoleLabel(string role)
    {
        return role switch
        {
            "SuperAdmin" => "Super Admin",
            "Admin" => "Administrador",
            _ => "Visualizador"
        };
    }

    private static string Friendly(Exception ex)
    {
        return ex switch
        {
            TaskCanceledException =>
                "A consulta demorou mais que o esperado.",

            HttpRequestException =>
                "Não foi possível conectar ao servidor.",

            _ => ex.Message
        };
    }
}

